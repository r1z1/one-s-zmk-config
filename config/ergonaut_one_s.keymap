#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Bump the default mouse move/scroll speeds up a bit before pulling in the
// macros, then tune acceleration below so a quick tap stays precise for
// clicking small UI targets, but holding a direction ramps up to a fast
// glide across the screen.
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200 // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20   // default: 10
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV 1
#define MOUSE 2
#define MEDIA 3
#define NUM 4
#define SYM 5
#define FUN 6
#define ADJ 7
#define ACCENT 8

// Requires CONFIG_ZMK_POINTING=y in your .conf (see below), otherwise the
// &mmv / &msc / &mkp bindings in the MOUSE layer will not do anything.
&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

&msc {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <0>;
};

/ {
        macros {
                // French accents: one reusable macro, parameterized by
                // (accent-mark, base-letter). Sends Compose (K_APP), then
                // the mark, then the letter. e.g. &accent SQT E -> é
                accent: accent_macro {
                        compatible = "zmk,behavior-macro-two-param";
                        #binding-cells = <2>;
                        bindings = <&macro_tap &kp K_APP>,
                                    <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                                    <&macro_param_2to1 &kp MACRO_PLACEHOLDER>;
                };

                arrow: arrow_macro {
                        compatible = "zmk,behavior-macro";
                        label = "ARROW";
                        #binding-cells = <0>;
                        bindings = <&kp MINUS &kp GT>;
                };
                fat_arrow: fat_arrow_macro {
                        compatible = "zmk,behavior-macro";
                        label = "FAT_ARROW";
                        #binding-cells = <0>;
                        bindings = <&kp EQUAL &kp GT>;
                };
                scope_res: scope_res_macro {
                        compatible = "zmk,behavior-macro";
                        label = "SCOPE_RES";
                        #binding-cells = <0>;
                        bindings = <&kp COLON &kp COLON>;
                };
        };

        combos {
                compatible = "zmk,combos";
                // Hold the two innermost thumb keys (TAB + RET, where the
                // left and right thumb clusters meet) from any layer to
                // reach ADJ (bluetooth profiles, bootloader, reset).
                combo_adj {
                        timeout-ms = <200>;
                        key-positions = <32 33>;
                        bindings = <&mo ADJ>;
                        slow-release;
                };

                // Hold the second pair of thumb keys out (SPACE + BSPC)
                // from any layer to reach the French accent layer.
                combo_accent {
                        timeout-ms = <200>;
                        key-positions = <31 34>;
                        bindings = <&mo ACCENT>;
                        slow-release;
                };
        };

        behaviors {
                hml: homerow_mods_left {
                        compatible = "zmk,behavior-hold-tap";
                        label = "HOMEROW_MODS_LEFT";
                        #binding-cells = <2>;
                        tapping-term-ms = <280>;
                        quick_tap_ms = <0>;
                        require-prior-idle-ms = <150>;
                        flavor = "balanced";
                        bindings = <&kp>, <&kp>;
                        // Only count a right-hand keypress as a valid hold
                        // trigger, so same-hand rolls (as, sd, df...) can't
                        // accidentally fire a modifier.
                        hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29>;
                        hold-trigger-on-release;
                };
                hmr: homerow_mods_right {
                        compatible = "zmk,behavior-hold-tap";
                        label = "HOMEROW_MODS_RIGHT";
                        #binding-cells = <2>;
                        tapping-term-ms = <280>;
                        quick_tap_ms = <0>;
                        require-prior-idle-ms = <150>;
                        flavor = "balanced";
                        bindings = <&kp>, <&kp>;
                        hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24>;
                        hold-trigger-on-release;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "MAIN";
                        bindings = <
   &kp Q       &kp W       &kp E          &kp R          &kp T             &kp Y        &kp U         &kp I        &kp O       &kp P
   &hml LGUI A  &hml LALT S  &hml LCTRL D    &hml LSHFT F    &kp G             &kp H        &hmr LSHFT J   &hmr LCTRL K  &hmr LALT L  &hmr LGUI SEMI
   &kp Z       &kp X       &kp C          &kp V          &kp B             &kp N        &kp M         &kp COMMA    &kp DOT     &kp FSLH
                           &lt MEDIA ESC  &lt NAV SPACE  &lt MOUSE TAB     &lt SYM RET  &lt NUM BSPC  &lt FUN DEL
                        >;
                };

                nav_layer {
                        display-name = "NAV";
                        bindings = <
   &kp LC(Z)  &kp LC(LS(Z))  &kp LC(X)      &kp LC(C)      &kp LC(V)         &none          &kp LC(LEFT)  &kp LC(RIGHT)  &none       &none
   &kp LGUI   &kp LALT       &kp LCTRL      &kp LSHFT      &none             &kp CAPS       &kp LEFT      &kp DOWN       &kp UP      &kp RIGHT
   &none      &none          &none          &none          &kp K_APP         &kp INS        &kp HOME      &kp PG_DN      &kp PG_UP   &kp END
                              &none          &none          &none             &kp RET        &kp BSPC      &kp DEL
                        >;
                };

                mouse_layer {
                        display-name = "MOUSE";
                        bindings = <
   &none       &mkp MB4    &mkp MB5       &none          &none             &none             &msc SCRL_LEFT   &msc SCRL_DOWN   &msc SCRL_UP     &msc SCRL_RIGHT
   &kp LGUI    &kp LALT    &kp LCTRL      &kp LSHFT      &none             &none             &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP     &mmv MOVE_RIGHT
   &none       &none       &none          &none          &none             &none             &none            &none            &none            &none
                           &none          &none          &none             &mkp LCLK         &mkp RCLK        &mkp MCLK
                        >;
                };

                media_layer {
                        display-name = "MEDIA";
                        bindings = <
   &none       &none       &none          &none          &none             &kp LG(LS(N4))    &none         &kp C_BRI_DN  &kp C_BRI_UP  &none
   &kp LGUI    &kp LALT    &kp LCTRL      &kp LSHFT      &none             &none             &kp LSHFT     &kp C_VOL_DN  &kp C_VOL_UP  &kp LGUI
   &none       &none       &none          &none          &none             &none             &none         &none         &none         &none
                           &none          &none          &none             &kp C_STOP        &kp C_PP      &kp K_MUTE
                        >;
                };

                num_layer {
                        display-name = "NUM";
                        bindings = <
   &kp LBKT    &kp N7      &kp N8         &kp N9         &kp RBKT          &none        &none         &none        &none       &none
   &kp SQT     &kp N4      &kp N5         &kp N6         &kp EQUAL         &none        &kp LSHFT     &kp LCTRL    &kp LALT    &kp LGUI
   &kp GRAVE   &kp N1      &kp N2         &kp N3         &kp BSLH          &none        &none         &none        &none       &none
                           &kp DOT        &kp N0         &kp MINUS         &none        &none         &none
                        >;
                };

                sym_layer {
                        display-name = "SYM";
                        bindings = <
   &kp HASH    &kp AT      &kp DLLR       &kp LPAR       &kp RPAR          &kp DQT      &kp STAR      &kp MINUS    &kp PLUS    &kp EQUAL
   &kp LBKT    &kp RBKT    &none          &kp LBRC       &kp RBRC          &scope_res   &kp AMPS      &kp EXCL     &kp COLON   &none
   &kp CARET   &none       &none          &kp LT         &kp GT            &kp PIPE     &kp QMARK     &kp LSHFT    &kp LCTRL   &kp LALT
                           &arrow         &fat_arrow     &kp UNDER         &none        &none         &none
                        >;
                };

                fun_layer {
                        display-name = "FUN";
                        bindings = <
   &kp F12     &kp F7      &kp F8         &kp F9         &kp PSCRN         &none        &none         &none        &none       &none
   &kp F11     &kp F4      &kp F5         &kp F6         &kp SLCK          &none        &kp LSHFT     &kp LCTRL    &kp LALT    &kp LGUI
   &kp F10     &kp F1      &kp F2         &kp F3         &kp PAUSE_BREAK   &none        &none         &none        &none       &none
                           &kp K_APP      &kp SPACE      &kp TAB           &none        &none         &none
                        >;
                };

                adj_layer {
                        display-name = "ADJ";
                        bindings = <
   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3 &bt BT_SEL 4   &bt BT_SEL 4   &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1 &bt BT_SEL 0
   &bt BT_CLR    &bt BT_PRV    &bt BT_NXT    &sys_reset   &bootloader    &bootloader    &sys_reset    &bt BT_NXT    &bt BT_PRV   &bt BT_CLR
   &out OUT_TOG  &out OUT_BLE  &out OUT_USB  &none        &studio_unlock &studio_unlock &none         &out OUT_USB  &out OUT_BLE &out OUT_TOG
                               &none         &none        &none          &none          &none       &none
                        >;
                };

                accent_layer {
                        display-name = "ACCENT";
                        bindings = <
   &accent SQT E   &accent GRAVE E  &accent CARET E   &accent DQT E    &accent GRAVE A   &accent CARET A  &accent COMMA C  &accent CARET O  &accent O E  &none
   &accent CARET I &accent DQT I    &accent GRAVE U   &accent CARET U  &accent DQT U     &none            &none            &none            &none        &none
   &none           &none            &none             &none            &none             &none            &none            &none            &none        &none
                                    &none             &none            &none             &none            &none            &none
                        >;
                };
        };
};
