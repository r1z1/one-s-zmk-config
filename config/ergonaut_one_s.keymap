#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Bump the default mouse move/scroll speeds up a bit before pulling in the
// macros, then tune acceleration below so a quick tap stays precise for
// clicking small UI targets, but holding a direction ramps up to a fast
// glide across the screen.
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200 // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20   // default: 10
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NUM_NAV 1
#define MOUSE 2
#define SYM 3
#define FUN 4
#define ADJ 5
#define ACCENT 6

// Requires CONFIG_ZMK_POINTING=y in your .conf, otherwise the
// &mmv / &msc / &mkp bindings in the MOUSE layer will not do anything.
&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

&msc {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <0>;
};

/ {
        macros {
                accent: accent_macro {
                        compatible = "zmk,behavior-macro-two-param";
                        #binding-cells = <2>;
                        bindings =
                                <&macro_param_1to1>,
                                <&kp MACRO_PLACEHOLDER>,
                                <&macro_param_2to1>,
                                <&kp MACRO_PLACEHOLDER>;
                };
                arrow: arrow_macro {
                        compatible = "zmk,behavior-macro";
                        label = "ARROW";
                        #binding-cells = <0>;
                        bindings = <&kp MINUS &kp GT>;
                };
                fat_arrow: fat_arrow_macro {
                        compatible = "zmk,behavior-macro";
                        label = "FAT_ARROW";
                        #binding-cells = <0>;
                        bindings = <&kp EQUAL &kp GT>;
                };
                scope_res: scope_res_macro {
                        compatible = "zmk,behavior-macro";
                        label = "SCOPE_RES";
                        #binding-cells = <0>;
                        bindings = <&kp COLON &kp COLON>;
                };
        };

        combos {
                compatible = "zmk,combos";
                // Hold the two innermost thumb keys (TAB + RET, where the
                // left and right thumb clusters meet) from any layer to
                // reach ADJ (bluetooth profiles, bootloader, reset).
                combo_adj {
                        timeout-ms = <200>;
                        key-positions = <32 33>;
                        bindings = <&mo ADJ>;
                        slow-release;
                };
        };

        behaviors {
                hml: homerow_mods_left {
                        compatible = "zmk,behavior-hold-tap";
                        label = "HOMEROW_MODS_LEFT";
                        #binding-cells = <2>;
                        tapping-term-ms = <280>;
                        quick-tap-ms = <0>;
                        require-prior-idle-ms = <150>;
                        flavor = "balanced";
                        bindings = <&kp>, <&kp>;
                        // Only count a right-hand keypress as a valid hold
                        // trigger, so same-hand rolls (as, sd, df...) can't
                        // accidentally fire a modifier.
                        hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29>;
                        hold-trigger-on-release;
                };
                hmr: homerow_mods_right {
                        compatible = "zmk,behavior-hold-tap";
                        label = "HOMEROW_MODS_RIGHT";
                        #binding-cells = <2>;
                        tapping-term-ms = <280>;
                        quick-tap-ms = <0>;
                        require-prior-idle-ms = <150>;
                        flavor = "balanced";
                        bindings = <&kp>, <&kp>;
                        hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24>;
                        hold-trigger-on-release;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "MAIN";
                        bindings = <
   &kp Q        &kp W        &kp E         &kp R          &kp T          &kp Y        &kp U         &kp I         &kp O        &kp P
   &hml LGUI A  &kp S        &kp D         &hml LSHFT F   &kp G          &kp H        &hmr LSHFT J  &hmr LCTRL K  &hmr LALT L  &hmr LGUI SEMI
   &kp Z        &kp X        &kp C         &kp V          &kp B          &kp N        &kp M         &kp COMMA     &kp DOT      &kp FSLH
                              &lt ACCENT ESC &lt NUM_NAV SPACE  &lt MOUSE TAB  &lt SYM RET  &lt NUM_NAV BSPC  &lt FUN DEL
                        >;
                };

                num_nav_layer {
                        display-name = "Num/Nav";
                        bindings = <
   &trans      &kp HOME    &kp UP         &kp END        &kp PG_UP         &kp N7       &kp N8        &kp N9       &kp MINUS   &trans
   &trans      &kp LEFT    &kp DOWN       &kp RIGHT      &kp PG_DN         &kp N4       &kp N5        &kp N6       &kp PLUS    &trans
   &trans      &trans      &trans         &trans         &trans            &kp N1       &kp N2        &kp N3       &kp N0      &trans
                           &trans         &trans         &trans            &trans       &trans        &trans
                        >;
                };

                mouse_layer {
                        display-name = "MOUSE";
                        bindings = <
   &trans       &mkp MB4    &mkp MB5       &trans          &trans             &trans             &msc SCRL_LEFT   &msc SCRL_DOWN   &msc SCRL_UP     &msc SCRL_RIGHT
   &kp LGUI    &kp LALT    &kp LCTRL      &kp LSHFT      &trans             &trans             &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP     &mmv MOVE_RIGHT
   &trans       &trans       &trans          &trans          &trans             &trans             &trans            &trans            &trans            &trans
                           &trans          &trans          &trans             &mkp LCLK         &mkp RCLK        &mkp MCLK
                        >;
                };

                sym_layer {
                        display-name = "SYM";
                        bindings = <
   &kp EXCL    &kp AT      &kp HASH       &kp DLLR       &kp PRCNT         &kp CARET    &kp AMPS      &kp STAR     &kp BSLH    &kp PIPE
   &kp EQUAL   &kp MINUS   &kp UNDER      &kp FSLH       &kp GRAVE         &kp LT       &kp LBRC      &kp LBKT     &kp LPAR    &kp DQT
   &kp PLUS    &kp COLON   &kp SEMI       &kp QMARK      &kp TILDE         &kp GT       &kp RBRC      &kp RBKT     &kp RPAR    &kp SQT
                           &arrow         &fat_arrow     &trans            &scope_res   &trans        &trans
                        >;
                };

                fun_layer {
                        display-name = "FUN";
                        bindings = <
   &kp F12     &kp F7      &kp F8         &kp F9         &kp PSCRN         &trans        &trans         &trans        &trans       &trans
   &kp F11     &kp F4      &kp F5         &kp F6         &kp SLCK          &trans        &kp LSHFT     &kp LCTRL    &kp LALT    &kp LGUI
   &kp F10     &kp F1      &kp F2         &kp F3         &kp PAUSE_BREAK   &trans        &trans         &trans        &trans       &trans
                           &trans          &kp SPACE      &kp TAB           &trans        &trans         &trans
                        >;
                };

                adj_layer {
                        display-name = "ADJ";
                        bindings = <
   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3 &bt BT_SEL 4   &bt BT_SEL 4   &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1 &bt BT_SEL 0
   &bt BT_CLR    &bt BT_PRV    &bt BT_NXT    &sys_reset   &bootloader    &bootloader    &sys_reset    &bt BT_NXT    &bt BT_PRV   &bt BT_CLR
   &out OUT_TOG  &out OUT_BLE  &out OUT_USB  &trans        &studio_unlock &studio_unlock &trans         &out OUT_USB  &out OUT_BLE &out OUT_TOG
                               &trans         &trans        &trans          &trans          &trans       &trans
                        >;
                };

                accent_layer {
                        display-name = "ACCENT";
                        bindings = <
   &accent SQT E   &accent GRAVE E   &accent CARET E   &accent DQT E   &accent GRAVE A   &accent CARET A   &accent COMMA C   &accent CARET O   &accent O E   &trans
   &accent CARET I &accent DQT I     &accent GRAVE U   &accent CARET U &accent DQT U     &trans             &trans             &trans             &trans         &trans
   &trans           &trans             &trans             &trans           &trans             &trans             &trans             &trans             &trans         &trans
                   &trans             &trans             &trans           &trans             &trans             &trans
                        >;
                };
        };
};
