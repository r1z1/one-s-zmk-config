#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Bump the default mouse move/scroll speeds up a bit before pulling in the
// macros, then tune acceleration below so a quick tap stays precise for
// clicking small UI targets, but holding a direction ramps up to a fast
// glide across the screen.
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200 // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20   // default: 10
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NUM_NAV 1
#define MOUSE 2
#define SYM 3
#define FUN 4
#define ADJ 5
#define ACCENT 6
#define VIM 7

// Requires CONFIG_ZMK_POINTING=y in your .conf, otherwise the
// &mmv / &msc / &mkp bindings in the MOUSE layer will not do anything.
&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

&msc {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <0>;
};

/ {
        macros {
                accent: accent_macro {
                        compatible = "zmk,behavior-macro-two-param";
                        #binding-cells = <2>;
                        bindings =
                                <&macro_param_1to1>,
                                <&kp MACRO_PLACEHOLDER>,
                                <&macro_param_2to1>,
                                <&kp MACRO_PLACEHOLDER>;
                };
                // Cedilla on US International: AltGr+comma is the dead key,
                // then c produces ç.
                cedilla: cedilla_macro {
                        compatible = "zmk,behavior-macro";
                        label = "CEDILLA";
                        #binding-cells = <0>;
                        bindings = <&kp RA(COMMA) &kp C>;
                };
                arrow: arrow_macro {
                        compatible = "zmk,behavior-macro";
                        label = "ARROW";
                        #binding-cells = <0>;
                        bindings = <&kp MINUS &kp GT>;
                };
                fat_arrow: fat_arrow_macro {
                        compatible = "zmk,behavior-macro";
                        label = "FAT_ARROW";
                        #binding-cells = <0>;
                        bindings = <&kp EQUAL &kp GT>;
                };
                scope_res: scope_res_macro {
                        compatible = "zmk,behavior-macro";
                        label = "SCOPE_RES";
                        #binding-cells = <0>;
                        bindings = <&kp COLON &kp COLON>;
                };
                mut_ref: mut_ref_macro {
                        compatible = "zmk,behavior-macro";
                        label = "MUT_REF";
                        #binding-cells = <0>;
                        bindings = <&kp AMPS &kp M &kp U &kp T &kp SPACE>;
                };
                word_up: word_up_macro {
                        compatible = "zmk,behavior-macro";
                        label = "WORD_UP";
                        #binding-cells = <0>;
                        bindings = <&kp LC(UP)>;
                };
                word_down: word_down_macro {
                        compatible = "zmk,behavior-macro";
                        label = "WORD_DOWN";
                        #binding-cells = <0>;
                        bindings = <&kp LC(DOWN)>;
                };
                word_left: word_left_macro {
                        compatible = "zmk,behavior-macro";
                        label = "WORD_LEFT";
                        #binding-cells = <0>;
                        bindings = <&kp LC(LEFT)>;
                };
                word_right: word_right_macro {
                        compatible = "zmk,behavior-macro";
                        label = "WORD_RIGHT";
                        #binding-cells = <0>;
                        bindings = <&kp LC(RIGHT)>;
                };
                sel_word_left: sel_word_left_macro {
                        compatible = "zmk,behavior-macro";
                        label = "SEL_WORD_LEFT";
                        #binding-cells = <0>;
                        bindings
                                = <&macro_press &kp LCTRL &kp LSHFT>
                                , <&macro_tap &kp LEFT>
                                , <&macro_release &kp LCTRL &kp LSHFT>
                                ;
                };
                sel_word_right: sel_word_right_macro {
                        compatible = "zmk,behavior-macro";
                        label = "SEL_WORD_RIGHT";
                        #binding-cells = <0>;
                        bindings
                                = <&macro_press &kp LCTRL &kp LSHFT>
                                , <&macro_tap &kp RIGHT>
                                , <&macro_release &kp LCTRL &kp LSHFT>
                                ;
                };
                vim_save: vim_save_macro {
                        compatible = "zmk,behavior-macro";
                        label = "VIM_SAVE";
                        #binding-cells = <0>;
                        bindings = <&kp COLON &kp W &kp RET>;
                };
                vim_wq: vim_wq_macro {
                        compatible = "zmk,behavior-macro";
                        label = "VIM_WQ";
                        #binding-cells = <0>;
                        bindings = <&kp COLON &kp W &kp Q &kp RET>;
                };
                vim_q: vim_q_macro {
                        compatible = "zmk,behavior-macro";
                        label = "VIM_Q";
                        #binding-cells = <0>;
                        bindings = <&kp COLON &kp Q &kp RET>;
                };
                vim_qa_force: vim_qa_force_macro {
                        compatible = "zmk,behavior-macro";
                        label = "VIM_QA_FORCE";
                        #binding-cells = <0>;
                        bindings = <&kp COLON &kp Q &kp A &kp EXCL &kp RET>;
                };
                vim_win_h: vim_win_h_macro {
                        compatible = "zmk,behavior-macro";
                        label = "VIM_WIN_H";
                        #binding-cells = <0>;
                        bindings
                                = <&macro_press &kp LCTRL>
                                , <&macro_tap &kp W>
                                , <&macro_release &kp LCTRL>
                                , <&macro_tap &kp H>
                                ;
                };
                vim_win_j: vim_win_j_macro {
                        compatible = "zmk,behavior-macro";
                        label = "VIM_WIN_J";
                        #binding-cells = <0>;
                        bindings
                                = <&macro_press &kp LCTRL>
                                , <&macro_tap &kp W>
                                , <&macro_release &kp LCTRL>
                                , <&macro_tap &kp J>
                                ;
                };
                vim_win_k: vim_win_k_macro {
                        compatible = "zmk,behavior-macro";
                        label = "VIM_WIN_K";
                        #binding-cells = <0>;
                        bindings
                                = <&macro_press &kp LCTRL>
                                , <&macro_tap &kp W>
                                , <&macro_release &kp LCTRL>
                                , <&macro_tap &kp K>
                                ;
                };
                vim_win_l: vim_win_l_macro {
                        compatible = "zmk,behavior-macro";
                        label = "VIM_WIN_L";
                        #binding-cells = <0>;
                        bindings
                                = <&macro_press &kp LCTRL>
                                , <&macro_tap &kp W>
                                , <&macro_release &kp LCTRL>
                                , <&macro_tap &kp L>
                                ;
                };
        };

        combos {
                compatible = "zmk,combos";
                // Hold the two innermost thumb keys (TAB + RET, where the
                // left and right thumb clusters meet) from any layer to
                // reach ADJ (bluetooth profiles, bootloader, reset).
                combo_adj {
                        timeout-ms = <200>;
                        key-positions = <32 33>;
                        bindings = <&mo ADJ>;
                        slow-release;
                };
                combo_vim {
                        timeout-ms = <200>;
                        key-positions = <34 35>;
                        bindings = <&mo VIM>;
                        slow-release;
                };

                // Only two symbol combos remain: W+R gives "(" and E+R gives
                // ")". They share R, so ZMK may wait briefly before deciding.
                combo_lparen {
                        timeout-ms = <18>;
                        require-prior-idle-ms = <150>;
                        key-positions = <1 3>;
                        layers = <BASE NUM_NAV>;
                        bindings = <&kp LPAR>;
                };
                combo_rparen {
                        timeout-ms = <18>;
                        require-prior-idle-ms = <150>;
                        key-positions = <2 3>;
                        layers = <BASE NUM_NAV>;
                        bindings = <&kp RPAR>;
                };
        };

        behaviors {
                // Home row mods use tap-preferred: a modifier only activates
                // when the key is actually held past tapping-term-ms, not when
                // another key is rolled over it. This stops false triggers
                // like "ai" -> Cmd+I or "so" -> Alt+O.
                hml: homerow_mods_left {
                        compatible = "zmk,behavior-hold-tap";
                        label = "HOMEROW_MODS_LEFT";
                        #binding-cells = <2>;
                        tapping-term-ms = <220>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        flavor = "tap-preferred";
                        bindings = <&kp>, <&kp>;
                };
                hmr: homerow_mods_right {
                        compatible = "zmk,behavior-hold-tap";
                        label = "HOMEROW_MODS_RIGHT";
                        #binding-cells = <2>;
                        tapping-term-ms = <220>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        flavor = "tap-preferred";
                        bindings = <&kp>, <&kp>;
                };
                hml_fn: homerow_fn_left {
                        compatible = "zmk,behavior-hold-tap";
                        label = "HOMEROW_FN_LEFT";
                        #binding-cells = <2>;
                        tapping-term-ms = <220>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        flavor = "tap-preferred";
                        bindings = <&mo>, <&kp>;
                };
                hmr_fn: homerow_fn_right {
                        compatible = "zmk,behavior-hold-tap";
                        label = "HOMEROW_FN_RIGHT";
                        #binding-cells = <2>;
                        tapping-term-ms = <220>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        flavor = "tap-preferred";
                        bindings = <&mo>, <&kp>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "MAIN";
                        bindings = <
   &kp Q        &kp W        &kp E         &kp R          &kp T          &kp Y        &kp U         &kp I         &kp O        &kp P
   &hml LGUI A  &hml LALT S  &hml LCTRL D  &hml LSHFT F   &hml_fn FUN G  &hmr_fn FUN H &hmr LSHFT J  &hmr LCTRL K  &hmr LALT L  &hmr LGUI SEMI
   &kp Z        &kp X        &kp C         &kp V          &kp B          &kp N        &kp M         &kp COMMA     &kp DOT      &kp FSLH
                              &lt ACCENT ESC &lt NUM_NAV SPACE  &lt MOUSE TAB  &lt SYM RET  &lt NUM_NAV BSPC  &lt FUN DEL
                        >;
                };

                num_nav_layer {
                        display-name = "Num/Nav";
                        bindings = <
   &word_up    &word_left  &kp UP         &word_right    &kp PG_UP         &kp MINUS    &kp N7        &kp N8       &kp N9      &kp FSLH
   &word_down  &kp LEFT    &kp DOWN       &kp RIGHT      &kp PG_DN         &kp PLUS     &kp N4        &kp N5       &kp N6      &kp STAR
   &trans      &kp LALT    &kp LCTRL      &kp LSHFT      &trans            &kp EQUAL    &kp N1        &kp N2       &kp N3      &kp N0
                             &sel_word_left &kp N0         &trans            &trans       &trans        &sel_word_right
                        >;
                };

                mouse_layer {
                        display-name = "MOUSE";
                        bindings = <
   &trans       &mkp MB4    &mkp MB5       &trans          &trans             &trans             &msc SCRL_LEFT   &msc SCRL_DOWN   &msc SCRL_UP     &msc SCRL_RIGHT
   &kp LGUI    &kp LALT    &kp LCTRL      &kp LSHFT      &trans             &trans             &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP     &mmv MOVE_RIGHT
   &trans       &trans       &trans          &trans          &trans             &trans             &trans            &trans            &trans            &trans
                           &trans          &trans          &trans             &mkp LCLK         &mkp RCLK        &mkp MCLK
                        >;
                };

                sym_layer {
                        display-name = "SYM";
                        bindings = <
   &kp EXCL    &kp AT      &kp HASH       &kp DLLR       &kp PRCNT         &kp CARET    &kp AMPS      &kp STAR     &kp BSLH    &kp PIPE
   &kp EQUAL   &kp MINUS   &kp UNDER      &kp FSLH       &kp GRAVE         &kp LT       &kp LBRC      &kp LBKT     &kp LPAR    &kp DQT
   &kp PLUS    &kp COLON   &kp SEMI       &mut_ref       &kp TILDE         &kp GT       &kp RBRC      &kp RBKT     &kp RPAR    &kp SQT
                           &arrow         &fat_arrow     &trans            &scope_res   &trans        &trans
                        >;
                };

                fun_layer {
                        display-name = "FUN";
                        bindings = <
   &kp F11     &trans      &trans         &trans         &kp PSCRN         &trans        &trans         &trans        &trans       &kp F12
   &kp F1      &kp F2      &kp F3         &kp F4         &kp F5            &kp F6        &kp F7         &kp F8        &kp F9       &kp F10
   &trans      &trans      &trans         &trans         &kp PAUSE_BREAK   &trans        &kp LSHFT      &kp LCTRL     &kp LALT     &kp LGUI
                           &trans          &kp SPACE      &kp TAB           &trans        &trans         &trans
                        >;
                };

                adj_layer {
                        display-name = "ADJ";
                        bindings = <
   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3 &bt BT_SEL 4   &bt BT_SEL 4   &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1 &bt BT_SEL 0
   &bt BT_CLR    &bt BT_PRV    &bt BT_NXT    &sys_reset   &bootloader    &bootloader    &sys_reset    &bt BT_NXT    &bt BT_PRV   &bt BT_CLR
   &out OUT_TOG  &out OUT_BLE  &out OUT_USB  &trans        &studio_unlock &studio_unlock &trans         &out OUT_USB  &out OUT_BLE &out OUT_TOG
                               &trans         &trans        &trans          &trans          &trans       &trans
                        >;
                };

                // Accent layer (hold the left thumb ACCENT key, then press the
                // letter). Dead-key accents send the US International dead key
                // then the letter. ç uses the cedilla macro (AltGr+comma, c).
                accent_layer {
                        display-name = "ACCENT";
                        bindings = <
   &accent DQT E    &accent GRAVE U  &accent SQT E    &accent GRAVE E  &accent CARET E  &accent CARET A  &cedilla         &accent CARET O  &trans        &accent CARET U
   &trans           &trans           &trans           &accent GRAVE A  &accent DQT U    &accent CARET I  &accent DQT I   &trans           &trans        &trans
   &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans        &trans
                    &trans           &trans           &trans           &trans           &trans           &trans
                        >;
                };

                vim_layer {
                        display-name = "VIM";
                        bindings = <
   &vim_save    &vim_wq     &vim_q         &vim_qa_force  &none             &none        &none         &kp LC(O)    &kp LC(I)   &none
   &none        &none       &none          &none          &none             &vim_win_h   &vim_win_j    &vim_win_k   &vim_win_l  &none
   &none        &none       &none          &none          &none             &none        &none         &none        &none       &none
                            &none           &none          &none             &none        &none         &none
                        >;
                };
        };
};
